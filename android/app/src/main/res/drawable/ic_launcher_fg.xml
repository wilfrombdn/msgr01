<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="108dp" android:height="108dp" android:viewportWidth="108" android:viewportHeight="108">
  <!-- one white 3D round chat bubble on black; scaled and centred so the round icon mask can't clip it -->
  <group android:scaleX="0.76" android:scaleY="0.76" android:pivotX="54" android:pivotY="54" android:translateX="3" android:translateY="-2">
    <!-- soft drop shadow -->
    <group android:translateX="3" android:translateY="7">
      <path android:pathData="M28,65 Q27,78 21,85 Q33,84 43.7,78.2 A30,30 0 1,0 28,65 Z" android:fillAlpha="0.5">
        <aapt:attr name="android:fillColor">
          <gradient android:type="linear" android:startX="54" android:startY="20" android:endX="54" android:endY="85"
              android:startColor="#00FFFFFF" android:endColor="#33FFFFFF" />
        </aapt:attr>
      </path>
    </group>
    <!-- the bubble's thickness: a darker copy pushed down-right -->
    <group android:translateX="2.2" android:translateY="4">
      <path android:pathData="M28,65 Q27,78 21,85 Q33,84 43.7,78.2 A30,30 0 1,0 28,65 Z">
        <aapt:attr name="android:fillColor">
          <gradient android:type="linear" android:startX="24" android:startY="20" android:endX="84" android:endY="85"
              android:startColor="#FF9C9CA2" android:endColor="#FF4A4A50" />
        </aapt:attr>
      </path>
    </group>
    <!-- the face: white fading to a cool light grey -->
    <path android:pathData="M28,65 Q27,78 21,85 Q33,84 43.7,78.2 A30,30 0 1,0 28,65 Z">
      <aapt:attr name="android:fillColor">
        <gradient android:type="linear" android:startX="30" android:startY="22" android:endX="80" android:endY="78"
            android:startColor="#FFFFFFFF" android:endColor="#FFC6C6CC" />
      </aapt:attr>
    </path>
    <!-- glossy highlight along the top -->
    <path android:pathData="M31,44 A24,24 0 0,1 77,44 Q54,35 31,44 Z">
      <aapt:attr name="android:fillColor">
        <gradient android:type="linear" android:startX="54" android:startY="22" android:endX="54" android:endY="44"
            android:startColor="#CCFFFFFF" android:endColor="#00FFFFFF" />
      </aapt:attr>
    </path>
  </group>
</vector>
