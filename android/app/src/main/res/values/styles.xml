<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- The app theme: the phone's dark/light default, with Android's own scrollbars switched off on every list.
         (Android flashed them each time a screen appeared, so they sat on the right edge during screen and tab slides.
         A list gets a slim bar once you drag it: Scrollbar.kt.) -->
    <style name="TellemTheme" parent="@android:style/Theme.DeviceDefault.NoActionBar">
        <item name="android:scrollViewStyle">@style/TellemScrollView</item>
        <item name="android:horizontalScrollViewStyle">@style/TellemHorizontalScrollView</item>
    </style>
    <style name="TellemScrollView" parent="@android:style/Widget.DeviceDefault.ScrollView">
        <item name="android:scrollbars">none</item>
    </style>
    <style name="TellemHorizontalScrollView" parent="@android:style/Widget.DeviceDefault.HorizontalScrollView">
        <item name="android:scrollbars">none</item>
    </style>
</resources>
