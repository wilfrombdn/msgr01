<?xml version="1.0" encoding="utf-8"?>
<paths>
    <!-- only the temporary unlocked copy of an attachment being opened -->
    <cache-path name="open" path="open/" />
    <!-- photo/video just captured by the in-app camera, before it's locked and sent -->
    <cache-path name="camera" path="camera/" />
    <!-- picture texts handed to / fetched by Android's MMS service -->
    <cache-path name="mms" path="mms/" />
</paths>
